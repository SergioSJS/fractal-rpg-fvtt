<div class="fractal-cfg">

  <nav class="cfg-tabs">
    <button type="button" class="cfg-tab-btn" data-action="switchTab" data-tab-idx="0">{{localize "FRACTAL.Config.AbaPersonagens"}}</button>
    <button type="button" class="cfg-tab-btn" data-action="switchTab" data-tab-idx="1">{{localize "FRACTAL.Config.AbaDesafios"}}</button>
    <button type="button" class="cfg-tab-btn" data-action="switchTab" data-tab-idx="2">{{localize "FRACTAL.Config.AbaGrupos"}}</button>
    <button type="button" class="cfg-tab-btn" data-action="switchTab" data-tab-idx="3">{{localize "FRACTAL.Config.AbaAparencia"}}</button>
  </nav>

  <div class="cfg-content">

    {{!-- PERSONAGENS --}}
    <div class="cfg-tab-body" data-cfg-tab="personagens">
      <p class="cfg-hint">{{localize "FRACTAL.Config.DicaPersonagens"}}</p>
      <div class="preset-bar">
        <span>{{localize "FRACTAL.Config.PreConfig"}}</span>
        <select class="preset-select" data-target="personagens">
          <option value="">{{localize "FRACTAL.Config.Escolher"}}</option>
          {{#each presetOpts as |p|}}
            <option value="{{p.key}}">{{p.nome}}</option>
          {{/each}}
        </select>
      </div>
      {{> "systems/fractal-rpg/templates/settings/reservas-header.hbs"}}
      <div class="reservas-list" data-target="reservasPersonagem">
        {{#each reservasPersonagem as |r|}}
          {{> "systems/fractal-rpg/templates/settings/reserva-row.hbs" r=r}}
        {{/each}}
      </div>
      <button type="button" class="btn-add-row" data-action="addReserva" data-target="reservasPersonagem">{{localize "FRACTAL.Config.AdicionarReserva"}}</button>

      <div class="cfg-subsection">
        <div class="cfg-subsection-title">{{localize "FRACTAL.Config.FatosPadrao"}}</div>
        <p class="cfg-hint">{{localize "FRACTAL.Config.DicaFatosPersonagem"}}</p>
        <div class="fatos-list" data-target="fatosPersonagem">
          {{#each fatosPersonagem as |f|}}
            {{> "systems/fractal-rpg/templates/settings/fato-padrao-row.hbs" f=f placeholder=(localize "FRACTAL.Config.TipoFatoPh")}}
          {{/each}}
        </div>
        <button type="button" class="btn-add-row" data-action="addFatoPadrao" data-target="fatosPersonagem">{{localize "FRACTAL.Config.AdicionarTipoFato"}}</button>
      </div>

      <div class="cfg-field">
        <label>{{localize "FRACTAL.Config.CorPersonagem"}}</label>
        <div class="cor-row">
          <input type="color" id="cor-picker" value="{{corAccent}}" />
          <input type="text"  id="cor-text"   value="{{corAccent}}" placeholder="#8B0000" maxlength="7" class="cor-text-input" />
        </div>
      </div>

      <div class="cfg-field">
        <label>{{localize "FRACTAL.Config.BgPersonagem"}}</label>
        <input type="text" data-field="bgPersonagem" value="{{backgroundPersonagem}}" placeholder="{{localize 'FRACTAL.Config.BgPh'}}" />
        <div class="opacity-row">
          <label class="opacity-label">{{localize "FRACTAL.Config.Opacidade"}}</label>
          <input type="range" data-field="bgOpacidadePersonagem" class="opacity-slider" min="0.05" max="1" step="0.05" value="{{bgOpacidadePersonagem}}" />
          <span class="opacity-val">{{bgOpacidadePersonagem}}</span>
        </div>
      </div>
    </div>

    {{!-- DESAFIOS --}}
    <div class="cfg-tab-body" data-cfg-tab="desafios">
      <p class="cfg-hint">{{localize "FRACTAL.Config.DicaDesafios"}}</p>
      <div class="preset-bar">
        <span>{{localize "FRACTAL.Config.PreConfig"}}</span>
        <select class="preset-select" data-target="desafios">
          <option value="">{{localize "FRACTAL.Config.Escolher"}}</option>
          {{#each presetOpts as |p|}}
            <option value="{{p.key}}">{{p.nome}}</option>
          {{/each}}
        </select>
      </div>
      {{> "systems/fractal-rpg/templates/settings/reservas-header.hbs"}}
      <div class="reservas-list" data-target="reservasDesafio">
        {{#each reservasDesafio as |r|}}
          {{> "systems/fractal-rpg/templates/settings/reserva-row.hbs" r=r}}
        {{/each}}
      </div>
      <button type="button" class="btn-add-row" data-action="addReserva" data-target="reservasDesafio">{{localize "FRACTAL.Config.AdicionarReserva"}}</button>

      <div class="cfg-subsection">
        <div class="cfg-subsection-title">{{localize "FRACTAL.Config.ObstaculosPadrao"}}</div>
        <p class="cfg-hint">{{localize "FRACTAL.Config.DicaObstaculos"}}</p>
        <div class="fatos-list" data-target="fatosDesafio">
          {{#each fatosDesafio as |f|}}
            {{> "systems/fractal-rpg/templates/settings/fato-padrao-row.hbs" f=f placeholder=(localize "FRACTAL.Config.TipoObstaculoPh")}}
          {{/each}}
        </div>
        <button type="button" class="btn-add-row" data-action="addFatoPadrao" data-target="fatosDesafio">{{localize "FRACTAL.Config.AdicionarTipoObstaculo"}}</button>
      </div>

      <div class="cfg-field">
        <label>{{localize "FRACTAL.Config.CorDesafio"}}</label>
        <div class="cor-row">
          <input type="color" id="cor-picker-desafio" value="{{corAccentDesafio}}" />
          <input type="text"  id="cor-text-desafio"   value="{{corAccentDesafio}}" placeholder="#5c3317" maxlength="7" class="cor-text-input" />
        </div>
      </div>

      <div class="cfg-field">
        <label>{{localize "FRACTAL.Config.BgDesafio"}}</label>
        <input type="text" data-field="bgDesafio" value="{{backgroundDesafio}}" placeholder="{{localize 'FRACTAL.Config.BgPh'}}" />
        <div class="opacity-row">
          <label class="opacity-label">{{localize "FRACTAL.Config.Opacidade"}}</label>
          <input type="range" data-field="bgOpacidadeDesafio" class="opacity-slider" min="0.05" max="1" step="0.05" value="{{bgOpacidadeDesafio}}" />
          <span class="opacity-val">{{bgOpacidadeDesafio}}</span>
        </div>
      </div>
    </div>

    {{!-- GRUPOS --}}
    <div class="cfg-tab-body" data-cfg-tab="grupos">
      <p class="cfg-hint">{{localize "FRACTAL.Config.DicaGrupos"}}</p>
      <div class="preset-bar">
        <span>{{localize "FRACTAL.Config.PreConfig"}}</span>
        <select class="preset-select" data-target="grupos">
          <option value="">{{localize "FRACTAL.Config.Escolher"}}</option>
          {{#each presetOpts as |p|}}
            <option value="{{p.key}}">{{p.nome}}</option>
          {{/each}}
        </select>
      </div>

      <div class="cfg-subsection">
        <div class="cfg-subsection-title">{{localize "FRACTAL.Config.FatosPadrao"}}</div>
        <p class="cfg-hint">{{localize "FRACTAL.Config.DicaFatosGrupo"}}</p>
        <div class="fatos-list" data-target="fatosGrupo">
          {{#each fatosGrupo as |f|}}
            {{> "systems/fractal-rpg/templates/settings/fato-padrao-row.hbs" f=f placeholder=(localize "FRACTAL.Config.TipoGrupoPh")}}
          {{/each}}
        </div>
        <button type="button" class="btn-add-row" data-action="addFatoPadrao" data-target="fatosGrupo">{{localize "FRACTAL.Config.AdicionarTipoFato"}}</button>
      </div>

      <div class="cfg-field">
        <label>{{localize "FRACTAL.Config.CorGrupo"}}</label>
        <div class="cor-row">
          <input type="color" id="cor-picker-grupo" value="{{corAccentGrupo}}" />
          <input type="text"  id="cor-text-grupo"   value="{{corAccentGrupo}}" placeholder="#0d5c2e" maxlength="7" class="cor-text-input" />
        </div>
      </div>

      <div class="cfg-field">
        <label>{{localize "FRACTAL.Config.BgGrupo"}}</label>
        <input type="text" data-field="bgGrupo" value="{{backgroundGrupo}}" placeholder="{{localize 'FRACTAL.Config.BgPh'}}" />
        <div class="opacity-row">
          <label class="opacity-label">{{localize "FRACTAL.Config.Opacidade"}}</label>
          <input type="range" data-field="bgOpacidadeGrupo" class="opacity-slider" min="0.05" max="1" step="0.05" value="{{bgOpacidadeGrupo}}" />
          <span class="opacity-val">{{bgOpacidadeGrupo}}</span>
        </div>
      </div>
    </div>

    {{!-- APARÊNCIA --}}
    <div class="cfg-tab-body" data-cfg-tab="aparencia">

      <div class="cfg-field">
        <div class="css-label-row">
          <label>{{localize "FRACTAL.Config.CSS"}}</label>
          <button type="button" class="btn-css-default" data-action="loadDefaultCss">{{localize "FRACTAL.Config.CarregarPadrao"}}</button>
        </div>
        <p class="cfg-hint css-instructions">{{{localize "FRACTAL.Config.DicaCSS"}}}</p>
        <textarea data-field="css" rows="14" class="css-area">{{cssCustomizado}}</textarea>
      </div>

    </div>
  </div>

  <footer class="cfg-footer">
    <button type="button" data-action="closeConfig">{{localize "FRACTAL.Comum.Cancelar"}}</button>
    <button type="button" data-action="saveConfig"><i class="fas fa-save"></i> {{localize "FRACTAL.Config.Salvar"}}</button>
  </footer>

</div>
